# Mentor Invoice - Backend Configuration

# Port the Go Gin server will listen on
PORT=8080

# MongoDB Connection (leave blank or comment out to run in standalone mock mode)
MONGO_URI=mongodb://localhost:27017

# Database Name (Zen Portal multi-tenant database)
MONGO_DB_NAME=zen_portal

# Redis Connection (used for caching and background worker pool)
REDIS_ADDR=localhost:6379

# Multi-tenancy program identifier (default: zen)
TENANT_PROGRAM=zen
